<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
    <url>
        <loc>{{ base_url }}/</loc>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>{{ base_url }}/category/news</loc>
        <changefreq>daily</changefreq>
        <priority>0.8</priority>
    </url>
    <url>
        <loc>{{ base_url }}/category/politics</loc>
        <changefreq>daily</changefreq>
        <priority>0.8</priority>
    </url>
    <url>
        <loc>{{ base_url }}/category/finance</loc>
        <changefreq>daily</changefreq>
        <priority>0.8</priority>
    </url>
    <url>
        <loc>{{ base_url }}/category/sci-tech</loc>
        <changefreq>daily</changefreq>
        <priority>0.8</priority>
    </url>
    {% for post in posts %}
    <url>
        <loc>{{ base_url }}/post/{{ post.slug }}</loc>
        <lastmod>{{ post.created_at[:10] }}</lastmod>
        <changefreq>daily</changefreq>
        <priority>0.9</priority>
        <xhtml:link rel="alternate" hreflang="en" href="{{ base_url }}/post/{{ post.slug }}?lang=en" />
        <xhtml:link rel="alternate" hreflang="hi" href="{{ base_url }}/post/{{ post.slug }}?lang=hi" />
    </url>
    {% endfor %}
</urlset>